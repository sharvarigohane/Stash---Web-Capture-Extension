{
  "manifest_version": 3,
  "name": "Stash",
  "version": "2.10.0",
  "description": "Smart web capture, focused notes and tasks in one popup.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stash",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current page to the Stash Inbox"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
